#!/usr/bin/env sh
# shellcheck disable=SC1091

set -eu

script_dir=$(dirname -- "$(realpath -- "$0")")
. "${script_dir}/../lib.sh"
backup_reject_args "$@"
sources_file="${script_dir}/sources"
if [ ! -r "${sources_file}" ]; then
	backup_fail "Unable to read source list '${sources_file}'; copy sources.example and configure it"
fi

if [ -z "${HOME:-}" ] || [ ! -d "${HOME}" ]; then
	backup_fail 'HOME is not a readable directory'
fi
home=$(CDPATH='' cd -- "${HOME}" && pwd -P) || backup_fail "Unable to resolve HOME '${HOME}'"
cloud_storage_root="${home}/Library/CloudStorage"
if [ ! -d "${cloud_storage_root}" ]; then
	backup_fail "Cloud storage directory '${cloud_storage_root}' does not exist"
fi

cloud_storage_count=0
for cloud_storage in "${cloud_storage_root}"/*; do
	[ -d "${cloud_storage}" ] || continue
	cloud_storage_count=$((cloud_storage_count + 1))
done
[ "${cloud_storage_count}" -gt 0 ] || backup_fail "No cloud storage directories found under '${cloud_storage_root}'"

ram_disk_sectors=8388608
ram_disk_image="ram://${ram_disk_sectors}"
ram_disk_volume="${RSYNC_CLOUD_RAMDISK_VOLUME:-rsync-cloud}"
case "${ram_disk_volume}" in
'' | *[!a-zA-Z0-9-]*) backup_fail 'Invalid RAM staging volume name' ;;
esac
ram_disk_mount="/Volumes/${ram_disk_volume}"
ram_disk_device=''
ram_disk_ready=0
staging_root=''
ram_disk_info_has_mount() {
	printf '%s\n' "$1" | awk -v expected_image="${ram_disk_image}" -v expected_mount="${ram_disk_mount}" '
		/^[[:space:]]*image-path[[:space:]]*:/ {
			image = $0
			sub(/^[^:]*:[[:space:]]*/, "", image)
		}
		/^[[:space:]]*mount-point[[:space:]]*:/ {
			mount = $0
			sub(/^[^:]*:[[:space:]]*/, "", mount)
			if (image == expected_image && mount == expected_mount) found = 1
		}
		image == expected_image && index($0, expected_mount) > 0 { found = 1 }
		END { exit !found }
	'
}
ram_disk_info_has_mount_path() {
	printf '%s\n' "$1" | awk -v expected_mount="${ram_disk_mount}" '
		/^[[:space:]]*mount-point[[:space:]]*:/ {
			mount = $0
			sub(/^[^:]*:[[:space:]]*/, "", mount)
			if (mount == expected_mount) found = 1
		}
		/^[[:space:]]*\/dev\/disk[0-9]+s[0-9]+[[:space:]]/ && index($0, expected_mount) > 0 { found = 1 }
		END { exit !found }
	'
}
clear_ram_staging() {
	for ram_disk_entry in "${ram_disk_mount}"/rsync-cloud.*; do
		[ -e "${ram_disk_entry}" ] || [ -L "${ram_disk_entry}" ] || continue
		if ! rm -rf -- "${ram_disk_entry}"; then
			return 1
		fi
	done
}
cleanup() {
	cleanup_status=$?
	trap - EXIT
	if [ -n "${staging_root}" ] && [ -d "${staging_root}" ]; then
		if ! rm -rf -- "${staging_root}"; then
			backup_log_error "Could not remove RAM staging directory '${staging_root}'"
			[ "${cleanup_status}" -ne 0 ] || cleanup_status=1
		fi
	fi
	if [ "${ram_disk_ready}" -eq 1 ]; then
		if ! clear_ram_staging; then
			backup_log_error "Could not clear RAM staging data from '${ram_disk_mount}'"
			[ "${cleanup_status}" -ne 0 ] || cleanup_status=1
		fi
	fi
	if [ "${ram_disk_ready}" -eq 0 ] && [ -n "${ram_disk_device}" ]; then
		if ! hdiutil detach "${ram_disk_device}" >/dev/null; then
			backup_log_error "Could not detach incomplete RAM staging disk '${ram_disk_device}'"
			[ "${cleanup_status}" -ne 0 ] || cleanup_status=1
		fi
	fi
	exit "${cleanup_status}"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

ram_disk_info=$(hdiutil info) || backup_fail 'Could not inspect the fixed RAM staging disk'
if ram_disk_info_has_mount_path "${ram_disk_info}" && ! ram_disk_info_has_mount "${ram_disk_info}"; then
	backup_fail "Refusing to clear a non-4-GiB RAM volume at '${ram_disk_mount}'"
elif ram_disk_info_has_mount "${ram_disk_info}"; then
	backup_log "Using existing 4 GiB RAM staging disk at '${ram_disk_mount}'"
else
	if [ -e "${ram_disk_mount}" ] || [ -L "${ram_disk_mount}" ]; then
		rmdir "${ram_disk_mount}" 2>/dev/null || backup_fail "Refusing to clear unrecognized volume at '${ram_disk_mount}'"
	fi
	backup_log "Creating a 4 GiB RAM staging disk at '${ram_disk_mount}'..."
	ram_disk_attach_output=$(hdiutil attach -nomount "${ram_disk_image}") || backup_fail 'Could not create a 4 GiB RAM staging disk'
	ram_disk_device=$(printf '%s\n' "${ram_disk_attach_output}" | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^\/dev\/disk[0-9]+$/) { print $i; exit } }')
	[ -n "${ram_disk_device}" ] || backup_fail 'Could not identify the RAM staging disk device'
	diskutil eraseVolume JHFSX "${ram_disk_volume}" "${ram_disk_device}" || backup_fail 'Could not format and mount the RAM staging disk'
fi
ram_disk_df=$(df -kP "${ram_disk_mount}") || backup_fail 'Could not verify RAM staging disk capacity'
ram_disk_size_kib=$(printf '%s\n' "${ram_disk_df}" | awk 'NR == 2 { print $2 }')
case "${ram_disk_size_kib}" in
'' | *[!0-9]*) backup_fail 'Could not determine RAM staging disk size' ;;
esac
if [ "${ram_disk_size_kib}" -lt 4000000 ] || [ "${ram_disk_size_kib}" -gt 4194304 ]; then
	backup_fail "RAM staging disk is not 4 GiB (${ram_disk_size_kib} KiB)"
fi
ram_disk_ready=1
clear_ram_staging || backup_fail "Could not clear RAM staging data from '${ram_disk_mount}' before backup"
staging_root=$(mktemp -d "${ram_disk_mount}/rsync-cloud.XXXXXX") || backup_fail 'Could not create a staging directory on the RAM disk'

log_staging_capacity() {
	if staging_df=$(df -h "${staging_root}"); then
		staging_capacity=$(printf '%s\n' "${staging_df}" | awk 'NR == 2 { printf "%s total, %s used, %s available", $2, $3, $4 }')
	else
		staging_capacity=''
	fi
	if [ -n "${staging_capacity}" ]; then
		backup_log "Temporary filesystem capacity: ${staging_capacity}"
	else
		backup_log_error 'Unable to determine temporary filesystem capacity'
	fi
}

# Retry with capped backoff; a full staging disk is fatal because it cannot recover.
rsync_with_retry() {
	retry_scope=$1
	shift
	retry_delay=1
	retry_attempt=1
	while :; do
		if rsync "$@"; then
			return 0
		else
			rsync_status=$?
		fi
		if [ "${retry_scope}" = staging ] && staging_df=$(df -kP "${staging_root}"); then
			staging_available=$(printf '%s\n' "${staging_df}" | awk 'NR == 2 { print $4 }')
			case "${staging_available:-}" in
			0) backup_fail 'The 4 GiB RAM staging disk is full; increase its size or reduce the source data' ;;
			esac
		fi
		backup_log_error "rsync attempt ${retry_attempt} failed with status ${rsync_status}; retrying in ${retry_delay}s"
		sleep "${retry_delay}"
		if [ "${retry_delay}" -lt 300 ]; then
			retry_delay=$((retry_delay * 2))
			[ "${retry_delay}" -le 300 ] || retry_delay=300
		fi
		retry_attempt=$((retry_attempt + 1))
	done
}

log_staging_capacity
source_count=0
source_path=''
while IFS= read -r source_path || [ -n "${source_path}" ]; do
	source_pattern=${source_path}
	case "${source_pattern}" in
	'' | \#*) continue ;;
	\~/*) source_pattern="${home}/${source_pattern#\~/}" ;;
	/*) ;;
	*) backup_fail "Source must be an absolute path or begin with ~/: '${source_pattern}'" ;;
	esac
	case "${source_pattern}" in
	"${home}"/*) ;;
	"${home}") backup_fail "Source must be inside HOME, not HOME itself: '${source_pattern}'" ;;
	*) backup_fail "Source must be inside HOME: '${source_pattern}'" ;;
	esac

	pattern_ifs=${IFS}
	IFS='
'
	# shellcheck disable=SC2086
	set -- ${source_pattern}
	IFS=${pattern_ifs}
	case "${source_pattern}" in
	*'*'* | *'?'* | *'['*)
		if [ "$#" -eq 1 ] && [ "$1" = "${source_pattern}" ] && [ ! -e "$1" ]; then
			backup_fail "Source pattern did not match any paths: '${source_pattern}'"
		fi
		;;
	esac

	for source_match do
		if [ ! -e "${source_match}" ]; then
			backup_fail "Source directory does not exist: '${source_match}'"
		fi
		if [ ! -d "${source_match}" ]; then
			backup_fail "Source match is not a directory: '${source_match}'"
		fi
		if ! absolute_source=$(CDPATH='' cd -- "${source_match}" && pwd -P); then
			backup_fail "Source directory cannot be read: '${source_match}'"
		fi
		case "${absolute_source}" in
		"${home}"/*) relative_source=${absolute_source#"${home}"/} ;;
		"${home}") backup_fail "Source must be inside HOME, not HOME itself: '${source_match}'" ;;
		*) backup_fail "Source must be inside HOME: '${source_match}'" ;;
		esac

		staged_source="${staging_root}/${relative_source}"
		mkdir -p -- "${staged_source}"
		backup_log "Staging '${absolute_source}' at '${staged_source}'..."
		rsync_with_retry staging -a --delete -- "${absolute_source}/" "${staged_source}/"
		source_count=$((source_count + 1))
	done
done <"${sources_file}"
[ "${source_count}" -gt 0 ] || backup_fail "No source directories configured in '${sources_file}'"
if du_output=$(du -sh "${staging_root}"); then
	staging_size=$(printf '%s\n' "${du_output}" | awk 'NR == 1 { print $1 }')
else
	staging_size=''
fi
if [ -n "${staging_size}" ]; then
	backup_log "Staged source data size: ${staging_size}"
else
	backup_log_error 'Unable to determine staged source data size'
fi
log_staging_capacity

for cloud_storage in "${cloud_storage_root}"/*; do
	[ -d "${cloud_storage}" ] || continue
	destination="${cloud_storage}/Backup"
	mkdir -p -- "${destination}"
	backup_log "Synchronizing to '${destination}'..."
	rsync_with_retry provider -a --delete -- "${staging_root}/" "${destination}/"
done

backup_log "Cloud synchronization complete (${source_count} source directories, ${cloud_storage_count} cloud storage directories)"
