#!/usr/bin/env sh
# shellcheck disable=SC1091

set -eu

script_dir=$(dirname -- "$(realpath -- "$0")")
. "${script_dir}/../lib.sh"
backup_reject_args "$@"
sources_file="${script_dir}/sources"
if [ ! -r "${sources_file}" ]; then
	backup_fail "Unable to read source list '${sources_file}'; copy sources.example and configure it"
fi

if [ -z "${HOME:-}" ] || [ ! -d "${HOME}" ]; then
	backup_fail 'HOME is not a readable directory'
fi
home=$(CDPATH='' cd -- "${HOME}" && pwd -P) || backup_fail "Unable to resolve HOME '${HOME}'"
cloud_storage_root="${home}/Library/CloudStorage"
if [ ! -d "${cloud_storage_root}" ]; then
	backup_fail "Cloud storage directory '${cloud_storage_root}' does not exist"
fi

cloud_storage_count=0
for cloud_storage in "${cloud_storage_root}"/*; do
	[ -d "${cloud_storage}" ] || continue
	cloud_storage_count=$((cloud_storage_count + 1))
done
[ "${cloud_storage_count}" -gt 0 ] || backup_fail "No cloud storage directories found under '${cloud_storage_root}'"

staging_root=$(mktemp -d /tmp/rsync-cloud.XXXXXX) || backup_fail 'Could not create a staging directory under /tmp'
cleanup() {
	rm -rf -- "${staging_root}"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

log_staging_capacity() {
	if staging_df=$(df -h "${staging_root}"); then
		staging_capacity=$(printf '%s\n' "${staging_df}" | awk 'NR == 2 { printf "%s total, %s used, %s available", $2, $3, $4 }')
	else
		staging_capacity=''
	fi
	if [ -n "${staging_capacity}" ]; then
		backup_log "Temporary filesystem capacity: ${staging_capacity}"
	else
		backup_log_error 'Unable to determine temporary filesystem capacity'
	fi
}

# Retry indefinitely; cap the delay so persistent failures do not cause a busy loop.
rsync_with_retry() {
	retry_delay=1
	retry_attempt=1
	while :; do
		if rsync "$@"; then
			return 0
		else
			rsync_status=$?
		fi
		backup_log_error "rsync attempt ${retry_attempt} failed with status ${rsync_status}; retrying in ${retry_delay}s"
		sleep "${retry_delay}"
		if [ "${retry_delay}" -lt 300 ]; then
			retry_delay=$((retry_delay * 2))
			[ "${retry_delay}" -le 300 ] || retry_delay=300
		fi
		retry_attempt=$((retry_attempt + 1))
	done
}

log_staging_capacity
source_count=0
source_path=''
while IFS= read -r source_path || [ -n "${source_path}" ]; do
	source_pattern=${source_path}
	case "${source_pattern}" in
	'' | \#*) continue ;;
	\~/*) source_pattern="${home}/${source_pattern#\~/}" ;;
	/*) ;;
	*) backup_fail "Source must be an absolute path or begin with ~/: '${source_pattern}'" ;;
	esac
	case "${source_pattern}" in
	"${home}"/*) ;;
	"${home}") backup_fail "Source must be inside HOME, not HOME itself: '${source_pattern}'" ;;
	*) backup_fail "Source must be inside HOME: '${source_pattern}'" ;;
	esac

	pattern_ifs=${IFS}
	IFS='
'
	# shellcheck disable=SC2086
	set -- ${source_pattern}
	IFS=${pattern_ifs}
	case "${source_pattern}" in
	*'*'* | *'?'* | *'['*)
		if [ "$#" -eq 1 ] && [ "$1" = "${source_pattern}" ] && [ ! -e "$1" ]; then
			backup_fail "Source pattern did not match any paths: '${source_pattern}'"
		fi
		;;
	esac

	for source_match do
		if [ ! -e "${source_match}" ]; then
			backup_fail "Source directory does not exist: '${source_match}'"
		fi
		if [ ! -d "${source_match}" ]; then
			backup_fail "Source match is not a directory: '${source_match}'"
		fi
		if ! absolute_source=$(CDPATH='' cd -- "${source_match}" && pwd -P); then
			backup_fail "Source directory cannot be read: '${source_match}'"
		fi
		case "${absolute_source}" in
		"${home}"/*) relative_source=${absolute_source#"${home}"/} ;;
		"${home}") backup_fail "Source must be inside HOME, not HOME itself: '${source_match}'" ;;
		*) backup_fail "Source must be inside HOME: '${source_match}'" ;;
		esac

		staged_source="${staging_root}/${relative_source}"
		mkdir -p -- "${staged_source}"
		backup_log "Staging '${absolute_source}' at '${staged_source}'..."
		rsync_with_retry -a --delete -- "${absolute_source}/" "${staged_source}/"
		source_count=$((source_count + 1))
	done
done <"${sources_file}"
[ "${source_count}" -gt 0 ] || backup_fail "No source directories configured in '${sources_file}'"
if du_output=$(du -sh "${staging_root}"); then
	staging_size=$(printf '%s\n' "${du_output}" | awk 'NR == 1 { print $1 }')
else
	staging_size=''
fi
if [ -n "${staging_size}" ]; then
	backup_log "Staged source data size: ${staging_size}"
else
	backup_log_error 'Unable to determine staged source data size'
fi
log_staging_capacity

for cloud_storage in "${cloud_storage_root}"/*; do
	[ -d "${cloud_storage}" ] || continue
	destination="${cloud_storage}/Backup"
	mkdir -p -- "${destination}"
	backup_log "Synchronizing to '${destination}'..."
	rsync_with_retry -a --delete -- "${staging_root}/" "${destination}/"
done

backup_log "Cloud synchronization complete (${source_count} source directories, ${cloud_storage_count} cloud storage directories)"
