#!/usr/bin/env sh
# shellcheck disable=SC1090,SC1091

set -eu

script_dir=$(dirname -- "$(realpath -- "$0")")
. "${script_dir}/../lib.sh"
backup_reject_args "$@"
backup_load_env "${script_dir}/.env" || exit 1

restic_forget_with_stale_lock_recovery() {
	if forget_output=$(LC_ALL=C run_restic_forget 2>&1); then
		if [ -n "${forget_output}" ]; then
			printf '%s\n' "${forget_output}"
		fi
		return 0
	else
		forget_status=$?
	fi

	case "${forget_output}" in
	*"repository is already locked"*) ;;
	*)
		printf '%s\n' "${forget_output}" >&2
		return "${forget_status}"
		;;
	esac

	lock_age=$(printf '%s\n' "${forget_output}" | awk -F '[()]' '/lock was created at/ { print $2; exit }')
	lock_age_hours=${lock_age%%h*}
	case "${lock_age_hours}" in
	'' | *[!0-9]*)
		printf '%s\n' "${forget_output}" >&2
		return "${forget_status}"
		;;
	esac
	if [ "${lock_age_hours}" -lt 24 ]; then
		printf '%s\n' "${forget_output}" >&2
		return "${forget_status}"
	fi

	backup_log "Restic lock is at least 24 hours old (${lock_age}); unlocking and retrying forget/prune..."
	printf '%s\n' "${forget_output}" >&2
	restic unlock
	run_restic_forget
}

run_restic_forget() {
	restic forget --group-by '' --keep-last 100 \
		--keep-within-hourly 7d --keep-within-daily 1m \
		--keep-within-weekly 1y --keep-within-monthly 5y \
		--keep-within-yearly 10y --prune --repack-uncompressed
}

set --
for p in \
	"${HOME}/Dropbox/Camera Uploads" \
	"${ICLOUD_HOME:-${HOME}/Library/Mobile Documents/com~apple~CloudDocs}" \
	"${HOME}/Pictures" \
	"${HOME}/work"; do
	if [ -d "${p}" ]; then
		backup_log "Backing up '${p}'..."
		set -- "$@" "${p}"
	else
		backup_log_error "Unable to find '${p}'; skipping..."
	fi
done

if [ "$#" -gt 0 ]; then
	restic backup --exclude .git \
		--exclude .venv \
		--exclude node_modules \
		--exclude 'Photos Library.photoslibrary' \
		--exclude target "$@"
fi

backup_log 'Forgetting & pruning...'
restic_forget_with_stale_lock_recovery
