#!/usr/bin/env sh
# shellcheck disable=SC1090,SC1091

set -eu

script_dir=$(dirname -- "$(realpath -- "$0")")
. "${script_dir}/../lib.sh"
backup_reject_args "$@"
backup_load_env "${script_dir}/.env" || exit 1

set --
for p in \
	"${HOME}/Dropbox/Camera Uploads" \
	"${ICLOUD_HOME:-${HOME}/Library/Mobile Documents/com~apple~CloudDocs}" \
	"${HOME}/Pictures" \
	"${HOME}/work"; do
	if [ -d "${p}" ]; then
		backup_log "Backing up '${p}'..."
		set -- "$@" "${p}"
	else
		backup_log_error "Unable to find '${p}'; skipping..."
	fi
done

if [ "$#" -gt 0 ]; then
	restic backup --exclude .git \
		--exclude .venv \
		--exclude node_modules \
		--exclude 'Photos Library.photoslibrary' \
		--exclude target "$@"
fi

backup_log 'Forgetting & pruning...'
restic forget --group-by '' --keep-last 100 \
	--keep-within-hourly 7d --keep-within-daily 1m \
	--keep-within-weekly 1y --keep-within-monthly 5y \
	--keep-within-yearly 10y --prune --repack-uncompressed
